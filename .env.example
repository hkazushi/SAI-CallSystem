# ─────────────────────────────────────────────
# SAI-CallSystem 環境変数テンプレート
# `cp .env.example .env.local` してから値を入れる
# ─────────────────────────────────────────────

# Supabase (本番接続時に設定)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # サーバー専用。絶対にクライアントへ出さない

# データソース切替 (mock | supabase)
DATA_SOURCE=mock                    # 本番接続時は `supabase`

# Anthropic / OpenAI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Vapi
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# Dialogflow CX (GCP)
GCP_PROJECT_ID=
GCP_LOCATION=asia-northeast1
GCP_SERVICE_ACCOUNT_JSON=           # Service Account JSON を1行で

# Google STT / TTS
GOOGLE_STT_LOCATION=asia-southeast1
GOOGLE_TTS_VOICE=ja-JP-Chirp3-HD-Aoede

# Webhook 共通シークレット (本SaaSがVapi/DFCXから受け取る側)
INBOUND_WEBHOOK_SECRET=

# 開発用: 認証バイパス
DEV_BYPASS_AUTH=false
DEV_FAKE_USER_EMAIL=demo@example.com
DEV_FAKE_ORG_ID=tenant-001
