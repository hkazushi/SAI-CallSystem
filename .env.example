# ============================================================================
# Dialogflow CX 接続設定
# Phase Bで実際にDFCXにデプロイ・テスト会話するために必要。
# ============================================================================

# GCPプロジェクトID (例: sai-voice-ai)
# Dialogflow CXコンソール上部に表示されるプロジェクト名。
GCP_PROJECT_ID=

# DFCXエージェントのリージョン
# 日本語運用なら asia-northeast1 推奨 (us-central1, global等も可)
GCP_LOCATION=asia-northeast1

# サービスアカウント鍵 (JSON全体を1行に圧縮して貼る)
# 作成手順:
#   1. GCPコンソール → IAMと管理 → サービスアカウント
#   2. 「サービスアカウントを作成」 → 名前: dfcx-deploy
#   3. ロール: Dialogflow API Admin
#   4. 作成後、キー → 新しい鍵 → JSON をダウンロード
#   5. 中身を jq -c . <file> で1行化して貼る
# 例: GCP_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"sai-voice-ai",...}
GCP_SERVICE_ACCOUNT_JSON=
