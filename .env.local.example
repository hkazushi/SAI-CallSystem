# SAI CallSystem - ローカル開発用環境変数テンプレート
# このファイルをコピーして .env.local を作成し、実際の値を入れる
# cp .env.local.example .env.local

# ============================================================
# アプリケーション
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# Vapi (音声AI SaaS)
# ============================================================
# 取得先: https://dashboard.vapi.ai/ → API Keys → Private Key
# Chappie が会話をまとめた結果を Vapi に投げて Assistant を作成するのに使う
VAPI_API_KEY=

# ============================================================
# Vercel AI Gateway (推奨: OIDC 認証で自動ルーティング)
# ============================================================
# 本番・プレビューでは Vercel が自動注入する。
# ローカル開発では次のコマンドで VERCEL_OIDC_TOKEN が自動的に .env.local に入る:
#   vercel link --project SAI-CallSystem
#   vercel env pull .env.local
#
# Gateway 経由で "openai/gpt-5.4" などの文字列を指定するだけで呼べる。
# 個別プロバイダの API キーは不要。
# VERCEL_OIDC_TOKEN=  ← vercel env pull が自動で入れる

# ============================================================
# フォールバック用プロバイダキー (Gateway を使わない場合のみ)
# ============================================================
# Gateway OIDC を使えない CI 環境などで必要になったら設定する。
# 通常は空のままで問題ない。
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ============================================================
# Google Cloud / Dialogflow CX (DFCX デプロイで使用)
# ============================================================
# DFCX Agent を自動生成・デプロイするのに使う Service Account 認証情報。
#
# 準備:
#   1. GCP Console で Conversational Agents API (旧 Dialogflow CX API) を有効化
#   2. Service Account を作成 (Roles: "Dialogflow API Admin")
#   3. JSON Key を発行し、改行を \\n に変換して 1 行で貼る
#      jq -c '.' service-account.json | tr -d '\n'
#
# GCP_PROJECT_ID=                           # プロジェクトID (例: my-sai-project-123456)
# GCP_LOCATION=asia-northeast1              # global または asia-northeast1 推奨
# GCP_SERVICE_ACCOUNT_JSON=                 # Service Account JSON を 1 行で貼る
# DFCX_MOCK_TOKEN=                          # ローカルテスト時のみ設定 (REST 通信せず compile 層を確認したい場合)

# ============================================================
# Supabase (後続フェーズで有効化)
# ============================================================
# NEXT_PUBLIC_SUBABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
